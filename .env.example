# Optional local foundation source. foundation:refresh requires at least one foundation source; in this phase only local is implemented.
# Quote it when exporting from a shell if it contains spaces or weird OneDrive/Windows-ish chars.
# Example: "/Users/me/Library/CloudStorage/OneDrive - Company/Foundation Docs"
FOUNDATION_DOCS_PATH=

# Optional Jira read-only capability. Leave every JIRA_* var empty/unset to disable Jira.
# API token docs: https://developer.atlassian.com/cloud/jira/platform/basic-auth-for-rest-apis/
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=tl-bot@example.com
JIRA_API_TOKEN=
JIRA_BOARD_ID=
# Optional. When present, API base becomes https://api.atlassian.com/ex/jira/{cloudId}
JIRA_CLOUD_ID=
JIRA_AUTH_MODE=basic

# Optional Confluence read-only capability. Defaults to JIRA_SITE_URL/JIRA_EMAIL/JIRA_API_TOKEN when omitted.
CONFLUENCE_SITE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_AUTH_MODE=basic
